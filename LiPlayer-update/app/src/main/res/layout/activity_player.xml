<?xml version="1.0" encoding="utf-8"?>
<!--
  Панель Media3 отключена (use_controller=false) — своя даёт нужный порядок
  элементов и лёгкое затемнение вместо штатных 60 % черноты.

  bottom_bar  : полоса прокрутки, под ней одна строка —
                время, назад, пуск/пауза, вперёд, настройки, запись, сдвиг
  menu_cats   : горизонтальное меню категорий НАД панелью
  menu_detail : вертикальное меню настроек НАД категориями
  scrim       : затемнение 5 % на паузе и при открытом меню
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="true"
    android:clipToPadding="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@android:color/black"
        app:surface_type="surface_view"
        app:resize_mode="fit"
        app:use_controller="false"
        app:show_buffering="when_playing" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D000000"
        android:visibility="gone" />

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="18dp"
        android:layout_marginRight="26dp"
        android:shadowColor="#FF000000"
        android:shadowRadius="6"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rec_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginTop="18dp"
        android:layout_marginLeft="22dp"
        android:background="@drawable/badge_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/rec_dot"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:contentDescription="@string/ctl_record"
            android:src="@drawable/ic_record" />

        <TextView
            android:id="@+id/rec_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="#B3000000"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- ================================================= список записей -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="470dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:background="@drawable/drawer_bg"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="120dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lib_recordings"
            android:textAllCaps="true"
            android:textColor="@color/brand_accent"
            android:textSize="14sp"
            android:letterSpacing="0.09" />

        <TextView
            android:id="@+id/drawer_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/drawer_empty"
            android:textColor="#8AFFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/drawer_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- ========================== вертикальное меню настроек, над категориями -->
    <LinearLayout
        android:id="@+id/menu_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:background="@drawable/popup_bg"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- =============================== горизонтальное меню категорий, над панелью -->
    <LinearLayout
        android:id="@+id/menu_cats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:background="@drawable/popup_bg"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- ============================================ всплывашка сдвига -->
    <LinearLayout
        android:id="@+id/popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:background="@drawable/popup_bg"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- ================================================== нижняя панель -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <!-- Полоса прокрутки: слева сколько прошло, справа вся длина -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="14dp"
                android:textColor="@color/brand_text"
                android:textSize="15sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/time_bar"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/time_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:textColor="@color/brand_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Кнопки слева, время по центру строки -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/menu_more"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_gear" />
                <ImageButton
                    android:id="@+id/btn_record"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/ctl_record"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_record" />
                <ImageButton
                    android:id="@+id/btn_rec_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/rec_pause"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btn_rec_snooze"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/rec_snooze"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause_timed"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btn_rec_stop"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/rec_stop"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_stop"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/btn_shift"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/ctl_shift"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shift" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/btn_rew"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/tr_rew"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_rew" />
                <ImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/tr_play"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause" />
                <ImageButton
                    android:id="@+id/btn_ffwd"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/tr_ffwd"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffwd" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/btn_mute"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/ctl_mute"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_volume" />
                <ImageButton
                    android:id="@+id/btn_ad"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_focus"
                    android:contentDescription="@string/ctl_ad"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ad" />
            </LinearLayout>

            <!-- Время и название по центру строки. Название ограничено по
                 ширине и обрезается: иначе длинное имя файла наехало бы
                 на кнопки слева. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:ellipsize="end"
                    android:maxWidth="360dp"
                    android:singleLine="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
