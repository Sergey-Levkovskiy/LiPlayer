<?xml version="1.0" encoding="utf-8"?>
<!--
  Всё управление собрано в одном левом столбце, сверху вниз:
  настройки, запись (+ список записей и индикатор), сдвиг, часы, транспорт.

  menu_cats   : первый уровень меню — Видео / Экран / Запись / Часы
  menu_detail : второй уровень — настройки выбранной категории, правее.
                Оба выравниваются по вертикали КОДОМ: панель встаёт на уровень
                своего пункта, а не по центру экрана.

  От панели Media3 остаётся только полоса времени внизу: центральный блок
  кнопок скрывается, транспорт живёт в правом столбце.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="true"
    android:clipToPadding="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@android:color/black"
        app:surface_type="surface_view"
        app:resize_mode="fit"
        app:use_controller="true"
        app:show_buffering="when_playing" />

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="#B3000000"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- Индикатор записи -->
    <LinearLayout
        android:id="@+id/rec_badge"
        android:layout_gravity="top|left"
        android:layout_marginTop="18dp"
        android:layout_marginLeft="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="7dp"
        android:paddingRight="9dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <ImageView
        android:id="@+id/rec_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:contentDescription="@string/ctl_record"
        android:src="@drawable/ic_record" />

        <TextView
        android:id="@+id/rec_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
    </LinearLayout>

    <!-- ================================== второй уровень меню (левее всех) -->
    <LinearLayout
        android:id="@+id/menu_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="20dp"
        android:background="@drawable/popup_bg"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- ============================================ первый уровень меню -->
    <LinearLayout
        android:id="@+id/menu_cats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="20dp"
        android:background="@drawable/bar_bg"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- ================================= всплывашка сдвига, у своей кнопки -->
    <LinearLayout
        android:id="@+id/popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="20dp"
        android:background="@drawable/popup_bg"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- ========================================== список записей, справа -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="470dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:layout_marginLeft="86dp"
        android:background="@drawable/drawer_bg"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lib_recordings"
            android:textAllCaps="true"
            android:textColor="@color/brand_accent"
            android:textSize="14sp"
            android:letterSpacing="0.09" />

        <TextView
            android:id="@+id/drawer_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/drawer_empty"
            android:textColor="#8AFFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/drawer_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- ============================================ правый столбец управления -->
    <LinearLayout
        android:id="@+id/side_col"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|center_vertical"
        android:layout_marginLeft="20dp"
        android:background="@drawable/bar_bg"
        android:gravity="left"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- 1. Настройки -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/btn_focus"
            android:contentDescription="@string/menu_more"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gear" />

        <!-- 2. Запись: одна кнопка превращается в три -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="left|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_record"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/btn_focus"
                android:contentDescription="@string/ctl_record"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_record" />

            <ImageButton
                android:id="@+id/btn_rec_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_focus"
                android:contentDescription="@string/rec_pause"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_rec_snooze"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_focus"
                android:contentDescription="@string/rec_snooze"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause_timed"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_rec_stop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_focus"
                android:contentDescription="@string/rec_stop"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Список записей -->
        <ImageButton
            android:id="@+id/btn_library"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/btn_focus"
            android:contentDescription="@string/lib_recordings"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_list" />

        <!-- 3. Сдвиг -->
        <ImageButton
            android:id="@+id/btn_shift"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/btn_focus"
            android:contentDescription="@string/ctl_shift"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shift" />

        <!-- 4. Время -->
        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginTop="4dp"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="4dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- 5. Перемотка и старт/пауза -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="left|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_rew"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/btn_focus"
                android:contentDescription="@string/tr_rew"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rew" />

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_focus"
                android:contentDescription="@string/tr_play"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btn_ffwd"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/btn_focus"
                android:contentDescription="@string/tr_ffwd"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ffwd" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
